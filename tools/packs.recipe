# Bundled cursor library recipe, consumed by tools/build-packs.ps1 (PackTool build).
#
# from = windows <dir>   upstream Windows build; roles come from its install.inf (or file names with detect = names)
# from = xcursor <dir>   Linux Xcursor theme folder, converted to .cur/.ani
# from = png             assembled from PNG icons listed per role (pngroot = folder)
# from = derive <id>     recolored variant of an already-built pack (neon = #RRGGBB)
#
# Role overrides: <Role> = file <name> | x11 <name> | png <file> [hot=..] [spin=n,ms] [pixel] | @<OtherRole> | none
# Paths are relative to the downloaded sources root (raw/ and work/, see tools/SOURCES.md).
# Sections starting with "_" are templates for include = ...; section order is the order within a category.

# ---- Templates ----------------------------------------------------------------------------------------

[_ful1e5]
author = Kaiz Khatri (ful1e5)
license = GPL-3.0-only
variant = Regular

[_hackneyed]
author = Richard Ferreira
license = X11-distribute-modifications-variant
url = https://gitlab.com/Enthymeme/hackneyed-x11-cursors
detect = names
variant = Standard
Arrow = file default.cur
Help = file help.cur
AppStarting = file progress.ani
Wait = file wait.ani
Crosshair = file crosshair.cur
IBeam = file text.cur
NWPen = file pencil.cur
No = file not-allowed.cur
SizeNS = file ns-resize.cur
SizeWE = file ew-resize.cur
SizeNWSE = file nwse-resize.cur
SizeNESW = file nesw-resize.cur
SizeAll = file move.cur
UpArrow = file sb_up_arrow.cur
Hand = file pointer.cur

[_retrosmart]
author = Manuel Domínguez López, useless-anvil
license = GPL-3.0-only
url = https://github.com/useless-anvil/retrosmart-cursor
detect = names
Arrow = file arrow.cur
Help = file help.cur
AppStarting = file appstarting.ani
Wait = file wait.ani
Crosshair = file crosshair.cur
IBeam = file ibeam.cur
NWPen = file nwpen.cur
No = file no.cur
SizeNS = file sizens.cur
SizeWE = file sizewe.cur
SizeNWSE = file sizenwse.cur
SizeNESW = file sizenesw.cur
SizeAll = file sizeall.cur
UpArrow = file uparrow.cur
Hand = file hand.cur

[_kenney]
author = Kenney (kenney.nl)
license = CC0-1.0
url = https://kenney.nl/assets/cursor-pack
from = png
pngroot = work/kenney/kenney_cursor-pack/PNG/Outline/Double
pngsizes = 32,48,64

[_comix]
author = Jens Luetkens, Ben Finney
license = GPL-3.0-or-later
url = https://gitlab.com/limitland/comixcursors
notes = Converted from the Debian comixcursors-righthanded 0.9.1 Xcursor theme

[_catppuccin]
author = Catppuccin, based on Volantes by varlesh
license = GPL-2.0-only
url = https://github.com/catppuccin/cursors
notes = Converted from the Xcursor theme to .cur/.ani

[_translucent]
author = silica-dev, based on Bibata by Kaiz Khatri (ful1e5)
license = GPL-3.0-only
url = https://github.com/silica-dev/Bibata_Cursor_Translucent
notes = Converted from the Xcursor theme to .cur/.ani
SizeAll = x11 fleur

[_neon]
author = Kaiz Khatri (ful1e5); neon glow by Cursors
license = GPL-3.0-only
url = https://github.com/ful1e5/Bibata_Cursor
notes = Derived from Bibata Modern Classic: outline recolored and a glow added
from = derive bibata-modern-classic

