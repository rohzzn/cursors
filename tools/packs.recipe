pngsizes = 32,48,64,96
Arrow = png tile_0168 hot=tl
Help = png tile_0181 hot=tl
AppStarting = png tile_0167 hot=tl
Wait = png tile_0013 hot=center spin=4,140
Crosshair = png tile_0057 hot=center
IBeam = png tile_0140 hot=center
NWPen = png tile_0146 hot=bl
No = png tile_0015 hot=center
SizeNS = png tile_0000 hot=center
SizeWE = png tile_0001 hot=center
SizeNWSE = png tile_0003 hot=center
SizeNESW = png tile_0002 hot=center
SizeAll = png tile_0005 hot=center
UpArrow = png tile_0070 hot=top
Hand = png tile_0134 hot=top

