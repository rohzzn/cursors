SizeWE = png resize_b_horizontal hot=center
SizeNWSE = png resize_b_diagonal_mirror hot=center
SizeNESW = png resize_b_diagonal hot=center
SizeAll = png resize_b_cross hot=center
UpArrow = png arrow_n hot=top
Hand = png gauntlet_point hot=tl

